# =============================================================================
# Environment Variables for University of Jos Journal System
# =============================================================================
# Copy this file to .env and update the values for your environment

# =============================================================================
# Django Settings
# =============================================================================
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# =============================================================================
# Database Settings (PostgreSQL for Production)
# =============================================================================
DB_NAME=uj_journal_db
DB_USER=uj_journal_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# Email Settings
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@unijosjournals.edu.ng
SERVER_EMAIL=server@unijosjournals.edu.ng

# =============================================================================
# Admin Settings
# =============================================================================
ADMIN_EMAIL=admin@unijosjournals.edu.ng

# =============================================================================
# Security Settings
# =============================================================================
SECURE_SSL_REDIRECT=True

# =============================================================================
# AWS S3 Settings (Optional - for media file storage)
# =============================================================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# Paystack (publication fees) — leave blank to disable online payments
# =============================================================================
# Use test keys (sk_test_… / pk_test_…) in development, live keys in production.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Optional: override the return URL Paystack sends the browser back to.
# PAYSTACK_CALLBACK_URL=https://josejournals.com/payments/callback/
# In the Paystack dashboard, set the webhook URL to:
#   https://josejournals.com/payments/webhook/
